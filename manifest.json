{
  "$schema": "../../../../core/schemas/manifest.schema.json",
  "manifestVersion": "1",
  "pluginId": "memo-plugin-tts-gptsovits",
  "version": "2.0.0",
  "title": "本地语音合成（Audio8 / GPT-SoVITS）",
  "description": "多后端本地 TTS provider，支持 Audio8 与 GPT-SoVITS。需要 Memo 1.8.8 或更高版本。",
  "type": "tts",
  "platforms": [
    "darwin"
  ],
  "arch": [
    "arm64"
  ],
  "importType": "module",
  "provider": {
    "value": "GPT-SoVITS TTS",
    "label": "GPT-SoVITS TTS"
  },
  "configuration": [
    {
      "label": "Model",
      "key": "model",
      "type": "select"
    },
    {
      "label": "Voice",
      "key": "voiceName",
      "type": "select"
    },
    {
      "label": "Catalog",
      "key": "catalogPath",
      "type": "text"
    }
  ],
  "defaultsConfiguration": {
    "model": "audio8",
    "voiceName": "",
    "catalogPath": ""
  },
  "configurationExposed": [
    "model",
    "voiceName",
    "catalogPath"
  ],
  "ttsInput": [
    "model",
    "voiceName",
    "catalogPath"
  ],
  "storageKey": "gptsovits",
  "configurationStorage": [
    "model",
    "voiceName",
    "catalogPath"
  ],
  "configurationRequired": [
    "voiceName",
    "catalogPath"
  ],
  "memoTtsEditor": {
    "fields": {
      "model": {
        "role": "model",
        "scope": "card"
      },
      "voiceName": {
        "role": "voice",
        "scope": "card"
      },
      "catalogPath": {
        "role": "text",
        "scope": "global"
      }
    }
  }
}
