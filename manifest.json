{
  "$schema": "../../../../core/schemas/manifest.schema.json",
  "manifestVersion": "1",
  "pluginId": "memo-plugin-tts-gptsovits",
  "version": "1.0.0",
  "title": "GPT-SoVITS TTS",
  "description": "Phase 0 minimal GPT-SoVITS TTS provider for Memo (silence-only placeholder).",
  "type": "tts",
  "platforms": [
    "darwin"
  ],
  "arch": [
    "arm64"
  ],
  "importType": "commonjs",
  "provider": {
    "value": "GPT-SoVITS TTS",
    "label": "GPT-SoVITS TTS"
  },
  "configuration": [
    {
      "label": "Language",
      "key": "language",
      "type": "@plugins-components/Language"
    },
    {
      "label": "Speed",
      "key": "speed",
      "type": "slider",
      "range": {
        "min": 0,
        "max": 100,
        "step": 1
      }
    }
  ],
  "defaultsConfiguration": {
    "language": "ZH_CN",
    "speed": 10
  },
  "configurationExposed": ["language", "speed"],
  "ttsInput": ["language", "speed"],
  "storageKey": "gptsovits",
  "configurationStorage": ["language", "speed"],
  "configurationRequired": []
}
